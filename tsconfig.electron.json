{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "outDir": "electron-build",
    "rootDir": "electron",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": [
      "node",
      "electron"
    ]
  },

  "include": [
    "electron/**/*.ts",
    "electron/**/*.cts"
  ]
}